PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/taskforge
JWT_ACCESS_SECRET=replace_with_random_64_char_string
JWT_REFRESH_SECRET=replace_with_another_random_64_char_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
CORS_ALLOW_ALL=true
COOKIE_SECURE=false

# AI Provider Configuration
# Set AI_PROVIDER to "ollama" (local) or "openai" (cloud)
AI_PROVIDER=ollama
AI_FALLBACK_ENABLED=false

# Ollama (local model — run: ollama serve && ollama pull qwen3:4b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=30000

# OpenAI (optional — only needed if AI_PROVIDER=openai or AI_FALLBACK_ENABLED=true)
OPENAI_API_KEY=sk-proj-replace_with_your_openai_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# MongoDB Atlas (production)
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/taskforge?retryWrites=true&w=majority
